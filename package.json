{
  "name": "foobara-www",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "npm run format && oxlint",
    "lint:ci": "npm run format:check && oxlint",
    "preview": "vite preview",
    "prebuild": "npx puppeteer browsers install chrome && tsx scripts/generate-sitemap.ts",
    "postbuild": "tsx scripts/prerender.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "format:css": "prettier --write \"src/**/*.css\"",
    "lint:css": "stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "puppeteer": "^25.18.1",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
